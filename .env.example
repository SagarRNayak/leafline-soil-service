# ==============================================================
# LEAFLINE NUTRIENT & SOIL SERVICE - ENVIRONMENT CONFIGURATION
# Primary source of truth: Specification V1.0
# ==============================================================

# Environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=production

# Development Mock Auth Mode (MUST be false in production)
MOCK_AUTH_MODE=false

# ==============================================================
# AWS RDS MYSQL DATABASE CONFIGURATION
# ==============================================================
# In production, point to your AWS RDS endpoint
DB_HOST=leafline-soil-db.cxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=leafline_soil
DB_USER=leafline_user
DB_PASSWORD=YourSecureRDSGeneratedPassword2026!

# Full SQLAlchemy Database Connection URL (Constructed from above if left blank)
# DATABASE_URL=mysql+pymysql://leafline_user:YourSecureRDSGeneratedPassword2026!@leafline-soil-db.cxxxxxxx.us-east-1.rds.amazonaws.com:3306/leafline_soil

# ==============================================================
# AUTHENTICATION & SECURITY TOKENS
# ==============================================================
# Secret key used for signing JWT access and refresh passes (min 32 random chars)
SECRET_KEY=generate_a_super_strong_random_secret_key_for_jwt_tokens_2026

# Token lifetimes per specification
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================
# EXTERNAL INTEGRATION ENDPOINTS
# ==============================================================
# Private internal URL to the Soil & Nutrient AI private service
SOIL_AI_URL=http://soil-ai.leafline.internal:9002/internal/soil-analyze

# External Identity & Access Management Service URL
IDENTITY_SERVICE_URL=https://auth.leafline.ag/auth

# ==============================================================
# LOGGING & MONITORING
# ==============================================================
LOG_LEVEL=INFO
